create_docker_compose_helper() {
    cat > "$CONFIG_DIR/docker-compose-refresh.sh" <<'COMPOSE_REFRESH'
@@BUILD:DOCKER_COMPOSE_TEMPLATE@@
COMPOSE_REFRESH
    chmod 700 "$CONFIG_DIR/docker-compose-refresh.sh"
}

hy2_hopping_helper_path() { printf '%s/hy2-port-hopping.sh\n' "$CONFIG_DIR"; }
hy2_hopping_openrc_path() { printf '/etc/init.d/sb-deploy-hy2-hopping\n'; }
hy2_hopping_systemd_path() { printf '/etc/systemd/system/sb-deploy-hy2-hopping.service\n'; }
hy2_hopping_runlevel_path() { printf '/etc/runlevels/default/sb-deploy-hy2-hopping\n'; }

cleanup_hy2_hopping_runtime() {
    local force_table="${1:-false}" helper openrc unit runlevel active=false failed=false enabled=false unit_removed=false
    helper=$(hy2_hopping_helper_path)
    openrc=$(hy2_hopping_openrc_path)
    unit=$(hy2_hopping_systemd_path)
    runlevel=$(hy2_hopping_runlevel_path)

    if [ "$OS" = alpine ]; then
        if [ ! -e "$helper" ] && [ ! -e "$openrc" ] && [ ! -L "$runlevel" ]; then
            return 0
        fi
        if [ -e "$openrc" ] && rc-service sb-deploy-hy2-hopping status >/dev/null 2>&1; then
            active=true
            rc-service sb-deploy-hy2-hopping stop || failed=true
        fi
    else
        systemctl is-enabled --quiet sb-deploy-hy2-hopping.service && enabled=true
        if [ ! -e "$helper" ] && [ ! -e "$unit" ] && [ "$enabled" = false ]; then
            return 0
        fi
        if [ -e "$unit" ]; then
            if systemctl is-active --quiet sb-deploy-hy2-hopping.service; then active=true; fi
            systemctl stop sb-deploy-hy2-hopping.service || failed=true
        fi
    fi

    if [ "$failed" = false ] && { [ "$force_table" = true ] || [ "$active" = true ]; } && [ -f "$helper" ] && [ -x "$helper" ]; then
        "$helper" clear || failed=true
    fi
    if [ "$failed" = false ]; then
        if [ "$OS" = alpine ] && [ -L "$runlevel" ]; then
            rc-update del sb-deploy-hy2-hopping default >/dev/null 2>&1 || failed=true
        elif [ "$OS" != alpine ] && { [ "$enabled" = true ] || [ -e "$unit" ]; }; then
            systemctl disable sb-deploy-hy2-hopping.service >/dev/null 2>&1 || failed=true
        fi
    fi
    if [ "$failed" = false ]; then
        if [ "$OS" = alpine ]; then
            rm -f "$openrc" "$helper" "$runlevel" || failed=true
        else
            if [ -e "$unit" ]; then
                rm -f "$unit" || failed=true
                [ ! -e "$unit" ] && unit_removed=true
            fi
            rm -f "$helper" || failed=true
        fi
    fi
    if [ "$OS" != alpine ] && [ "$unit_removed" = true ]; then
        systemctl daemon-reload || failed=true
    fi
    if [ "$failed" = true ]; then
        err "清理 HY2 跳跃运行时失败；请人工检查 sb-deploy-hy2-hopping 服务及 inet sb_deploy_hy2 表"
        return 1
    fi
    return 0
}

rollback_hy2_hopping_runtime() {
    cleanup_hy2_hopping_runtime true || { err "HY2 跳跃运行时回滚不完整"; return 1; }
}

setup_hy2_hopping_runtime() {
    [ "$DEPLOY_MODE" = host ] || return 0
    if [ "${ENABLE_HY2:-false}" != true ] || [ "${HY2_HOPPING_ENABLED:-false}" != true ]; then
        cleanup_hy2_hopping_runtime false
        return $?
    fi
    HY2_HOPPING_FORWARD_MODE=$(normalize_hy2_forward_mode "${HY2_HOPPING_FORWARD_MODE:-}" true host) || return 1
    if [ "$HY2_HOPPING_FORWARD_MODE" = external ]; then
        cleanup_hy2_hopping_runtime false
        return $?
    fi
    probe_nftables_access || { err "HY2 nftables 不可用，未创建跳跃运行时"; return 1; }
    local helper openrc unit
    helper=$(hy2_hopping_helper_path); openrc=$(hy2_hopping_openrc_path); unit=$(hy2_hopping_systemd_path)

    cat > "$helper" <<'HOPPING_SCRIPT' || { rollback_hy2_hopping_runtime; return 1; }
#!/usr/bin/env bash
set -euo pipefail
CONFIG_DIR="$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd)"
cache_value() { awk -F= -v key="$1" '$1==key {sub(/^[^=]*=/, ""); print; exit}' "$CONFIG_DIR/.config_cache" 2>/dev/null || true; }
clear_table() {
  local tables
  tables=$(nft list tables) || return 1
  if printf '%s\n' "$tables" | grep -Fxq 'table inet sb_deploy_hy2'; then
    nft delete table inet sb_deploy_hy2
  fi
}
apply_table() {
  local start="$1" end="$2" port="$3" tables
  tables=$(nft list tables) || return 1
  {
    if printf '%s\n' "$tables" | grep -Fxq 'table inet sb_deploy_hy2'; then
      printf '%s\n' 'delete table inet sb_deploy_hy2'
    fi
    printf '%s\n' \
      'add table inet sb_deploy_hy2' \
      'add chain inet sb_deploy_hy2 prerouting { type nat hook prerouting priority dstnat; policy accept; }'
    printf 'add rule inet sb_deploy_hy2 prerouting udp dport %s-%s redirect to :%s\n' "$start" "$end" "$port"
  } | nft -f -
}
case "${1:-}" in
  clear) clear_table ;;
  apply)
    enabled=$(cache_value HY2_HOPPING_ENABLED)
    if [ "$enabled" != true ]; then clear_table; exit 0; fi
    start=$(cache_value HY2_HOP_START); end=$(cache_value HY2_HOP_END); interval=$(cache_value HY2_HOP_INTERVAL)
    port=$(jq -er '.inbounds[]|select(.type=="hysteria2")|.listen_port' "$CONFIG_DIR/config.json")
    [[ "$start" =~ ^[0-9]{1,5}$ && "$end" =~ ^[0-9]{1,5}$ && "$interval" =~ ^[0-9]{1,4}$ ]] || { echo '[ERR] HY2 跳跃缓存无效' >&2; exit 1; }
    start=$((10#$start)); end=$((10#$end)); interval=$((10#$interval)); count=$((end-start+1))
    (( start >= 1 && end <= 65535 && start == port && count >= 2 && count <= 100 && interval >= 5 && interval <= 3600 )) || { echo '[ERR] HY2 跳跃配置校验失败' >&2; exit 1; }
    apply_table "$start" "$end" "$port"
    ;;
  *) exit 2 ;;
esac
HOPPING_SCRIPT
    chmod 700 "$helper" || { rollback_hy2_hopping_runtime; return 1; }
    if [ "$OS" = alpine ]; then
        cat > "$openrc" <<'OPENRC_HOP' || { rollback_hy2_hopping_runtime; return 1; }
#!/sbin/openrc-run
name="sb-deploy-hy2-hopping"
command="/etc/sing-box/hy2-port-hopping.sh"
depend() { need net; before sing-box; }
start() { "$command" apply; }
stop() { "$command" clear; }
OPENRC_HOP
        chmod +x "$openrc" || { rollback_hy2_hopping_runtime; return 1; }
        rc-update add sb-deploy-hy2-hopping default >/dev/null 2>&1 || { rollback_hy2_hopping_runtime; return 1; }
        rc-service sb-deploy-hy2-hopping start || { rollback_hy2_hopping_runtime; return 1; }
    else
        cat > "$unit" <<'SYSTEMD_HOP' || { rollback_hy2_hopping_runtime; return 1; }
[Unit]
Description=sb-deploy HY2 UDP port hopping
Before=sing-box.service
[Service]
Type=oneshot
RemainAfterExit=yes
ExecStart=/etc/sing-box/hy2-port-hopping.sh apply
ExecStop=/etc/sing-box/hy2-port-hopping.sh clear
[Install]
WantedBy=multi-user.target
SYSTEMD_HOP
        systemctl daemon-reload || { rollback_hy2_hopping_runtime; return 1; }
        systemctl enable sb-deploy-hy2-hopping.service >/dev/null 2>&1 || { rollback_hy2_hopping_runtime; return 1; }
        systemctl restart sb-deploy-hy2-hopping.service || { rollback_hy2_hopping_runtime; return 1; }
    fi
    return 0
}

# -----------------------
# 设置服务
setup_service() {
    setup_hy2_hopping_runtime
    if [ "$DEPLOY_MODE" = "docker" ]; then
        info "配置 Docker Compose 服务..."
        create_docker_compose_helper
        "$CONFIG_DIR/docker-compose-refresh.sh"
        SERVICE_PATH="$CONFIG_DIR/docker-compose.yml"
        docker_compose config >/dev/null && docker_compose up -d || {
            err "Docker 容器启动失败"
            docker_compose logs --tail 30 || true
            exit 1
        }
        sleep 2
        local container_id
        container_id="$(docker_compose ps -q sing-box)"
        if [ -n "$container_id" ] && [ "$(docker inspect -f '{{.State.Running}}' "$container_id" 2>/dev/null || true)" = "true" ]; then
            info "✅ Docker 容器已启动"
        else
            err "Docker 容器状态异常"
            docker_compose logs --tail 30 || true
            exit 1
        fi
        info "服务配置完成: $SERVICE_PATH"
        return 0
    fi

    info "配置系统服务..."

    if [ "$OS" = "alpine" ]; then
        SERVICE_PATH="/etc/init.d/sing-box"
        local output_log_path="/dev/null"
        local error_log_path="/dev/null"
        if [ "$LOG_ENABLED" = "true" ]; then
            output_log_path="/var/log/sing-box.log"
            error_log_path="/var/log/sing-box.err"
        fi

        cat > "$SERVICE_PATH" <<'OPENRC'
#!/sbin/openrc-run

name="sing-box"
description="Sing-box Proxy Server"
command="/usr/bin/sing-box"
command_args="run -c /etc/sing-box/config.json"
pidfile="/run/${RC_SVCNAME}.pid"
command_background="yes"
output_log="__OPENRC_OUTPUT_LOG__"
error_log="__OPENRC_ERROR_LOG__"
# 自动拉起（程序崩溃、OOM、被 kill 后自动恢复）
supervisor=supervise-daemon
supervise_daemon_args="--respawn-max 0 --respawn-delay 5"

depend() {
    need net
    after firewall
}

start_pre() {
    checkpath --directory --mode 0755 /var/log
    checkpath --directory --mode 0755 /run
}
OPENRC
        sed -i "s|__OPENRC_OUTPUT_LOG__|$output_log_path|;s|__OPENRC_ERROR_LOG__|$error_log_path|" "$SERVICE_PATH"

        chmod +x "$SERVICE_PATH"
        rc-update add sing-box default >/dev/null 2>&1 || warn "添加开机自启失败"
        rc-service sing-box restart || {
            err "服务启动失败"
            if [ "$LOG_ENABLED" = "true" ]; then
                tail -20 /var/log/sing-box.err 2>/dev/null || tail -20 /var/log/sing-box.log 2>/dev/null || true
            else
                warn "当前日志已关闭，请重新运行安装器并开启日志后排查服务错误"
            fi
            exit 1
        }

        sleep 2
        if rc-service sing-box status >/dev/null 2>&1; then
            info "✅ OpenRC 服务已启动"
        else
            err "服务状态异常"
            exit 1
        fi

    else
        SERVICE_PATH="/etc/systemd/system/sing-box.service"
        local systemd_stdout="null"
        local systemd_stderr="null"
        if [ "$LOG_ENABLED" = "true" ]; then
            systemd_stdout="journal"
            systemd_stderr="journal"
        fi

        cat > "$SERVICE_PATH" <<'SYSTEMD'
[Unit]
Description=Sing-box Proxy Server
Documentation=https://sing-box.sagernet.org
After=network.target nss-lookup.target
Wants=network.target

[Service]
Type=simple
User=root
WorkingDirectory=/etc/sing-box
ExecStart=/usr/bin/sing-box run -c /etc/sing-box/config.json
StandardOutput=__SYSTEMD_STDOUT__
StandardError=__SYSTEMD_STDERR__
ExecReload=/bin/kill -HUP $MAINPID
Restart=on-failure
RestartSec=10s
LimitNOFILE=1048576

[Install]
WantedBy=multi-user.target
SYSTEMD
        sed -i "s|__SYSTEMD_STDOUT__|$systemd_stdout|;s|__SYSTEMD_STDERR__|$systemd_stderr|" "$SERVICE_PATH"

        systemctl daemon-reload
        systemctl enable sing-box >/dev/null 2>&1
        systemctl restart sing-box || {
            err "服务启动失败"
            if [ "$LOG_ENABLED" = "true" ]; then
                journalctl -u sing-box -n 30 --no-pager
            else
                warn "当前日志已关闭，请重新运行安装器并开启日志后排查服务错误"
            fi
            exit 1
        }

        sleep 2
        if systemctl is-active sing-box >/dev/null 2>&1; then
            info "✅ Systemd 服务已启动"
        else
            err "服务状态异常"
            exit 1
        fi
    fi

    info "服务配置完成: $SERVICE_PATH"
}

setup_service

